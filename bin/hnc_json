#!/system/bin/sh
# HNC hotfix18.9 - unified JSON helper frontend (bootstrap version)
#
# Goals:
#   - Provide one stable CLI contract for future JSON operations.
#   - Keep this first version low risk: validate/get are implemented here;
#     set-top delegates to the already hardened json_set.sh from hotfix18.0+.
#
# Usage:
#   hnc_json validate <file>
#   hnc_json get-top <file> <key>
#   hnc_json set-top <file> <key> <value> [str|num|bool|null]
#   hnc_json version

set -eu

SELF="$0"
BINDIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)"
JSON_GUARD="$BINDIR/json_guard.sh"
JSON_SET="$BINDIR/json_set.sh"

usage() {
  cat <<'USAGE'
Usage:
  hnc_json validate <file>
  hnc_json get-top <file> <key>
  hnc_json set-top <file> <key> <value> [str|num|bool|null]
  hnc_json version
USAGE
}

json_escape() {
  # JSON string escape for shell input. Keeps UTF-8 bytes as-is and escapes
  # control chars that commonly appear in Android shell strings.
  awk 'BEGIN{
    s=ARGV[1]; ARGV[1]="";
    out="";
    for(i=1;i<=length(s);i++){
      c=substr(s,i,1);
      if(c=="\\") out=out "\\\\";
      else if(c=="\"") out=out "\\\"";
      else if(c=="\b") out=out "\\b";
      else if(c=="\f") out=out "\\f";
      else if(c=="\n") out=out "\\n";
      else if(c=="\r") out=out "\\r";
      else if(c=="\t") out=out "\\t";
      else out=out c;
    }
    print out;
  }' "$1"
}

validate_file() {
  f="$1"
  [ -f "$f" ] || { echo "hnc_json: missing file: $f" >&2; return 2; }
  if [ -x "$JSON_GUARD" ]; then
    "$JSON_GUARD" "$f" >/dev/null
    return $?
  fi
  # Fallback: minimal structural validator. Not a full parser; intended only
  # when json_guard.sh is unavailable.
  awk '
  BEGIN{in_s=0; esc=0; depth=0; ok=1}
  {
    for(i=1;i<=length($0);i++){
      c=substr($0,i,1)
      if(in_s){
        if(esc){esc=0; continue}
        if(c=="\\"){esc=1; continue}
        if(c=="\""){in_s=0; continue}
        continue
      }
      if(c=="\""){in_s=1; continue}
      if(c=="{" || c=="[") depth++
      else if(c=="}" || c=="]") {depth--; if(depth<0) ok=0}
    }
  }
  END{ if(in_s||esc||depth!=0||!ok) exit 1; exit 0 }' "$f"
}

get_top() {
  f="$1"; key="$2"
  validate_file "$f" || return $?
  awk -v key="$key" '
  function emit(v){ print v; found=1; exit 0 }
  BEGIN{ in_s=0; esc=0; depth=0; reading_key=0; k=""; want_val=0; val=""; val_s=0; val_esc=0 }
  {
    line=$0 "\n"
    for(i=1;i<=length(line);i++){
      c=substr(line,i,1)
      if(want_val){
        if(val_s){
          val=val c
          if(val_esc){val_esc=0; continue}
          if(c=="\\"){val_esc=1; continue}
          if(c=="\""){ emit(val); }
          continue
        }
        if(c ~ /[ \t\r\n]/) continue
        if(c=="\""){val_s=1; val="\""; continue}
        val=c
        # primitive value: read until comma/end top object
        for(j=i+1;j<=length(line);j++){
          d=substr(line,j,1)
          if(d=="," || d=="}"){ emit(val); }
          val=val d
        }
        continue
      }
      if(in_s){
        if(esc){ if(reading_key) k=k c; esc=0; continue }
        if(c=="\\"){ if(reading_key) k=k c; esc=1; continue }
        if(c=="\""){
          in_s=0
          if(reading_key){ reading_key=0; got_key=k; k="" }
          continue
        }
        if(reading_key) k=k c
        continue
      }
      if(c=="\""){
        in_s=1
        if(depth==1){ reading_key=1; k="" }
        continue
      }
      if(c=="{") depth++
      else if(c=="}") depth--
      else if(c==":" && depth==1 && got_key==key){ want_val=1 }
    }
  }
  END{ if(!found) exit 3 }' "$f"
}

set_top() {
  f="$1"; key="$2"; value="$3"; typ="${4:-str}"
  [ -x "$JSON_SET" ] || { echo "hnc_json: json_set.sh unavailable for set-top" >&2; return 2; }
  case "$typ" in
    str|string) "$JSON_SET" top "$key" "$value" ;;
    num|number|bool|boolean|null) "$JSON_SET" top "$key" "$value" ;;
    *) echo "hnc_json: bad type: $typ" >&2; return 2 ;;
  esac
  validate_file "$f"
}

cmd="${1:-}"
case "$cmd" in
  validate)
    [ $# -eq 2 ] || { usage >&2; exit 2; }
    validate_file "$2"
    ;;
  get-top|get)
    [ $# -eq 3 ] || { usage >&2; exit 2; }
    get_top "$2" "$3"
    ;;
  set-top|set)
    [ $# -ge 4 ] && [ $# -le 5 ] || { usage >&2; exit 2; }
    set_top "$2" "$3" "$4" "${5:-str}"
    ;;
  version)
    echo "hnc_json bootstrap hotfix18.9"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
